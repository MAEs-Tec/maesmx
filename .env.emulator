# Entorno local con emuladores de Firebase. Este archivo SÍ se sube al repo:
# no contiene nada real. Vite lo carga con `vite --mode emulator`
# (lo usa `npm run dev:local`).
#
# El proyecto "demo-*" garantiza que el SDK nunca toque un proyecto real.
VITE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-maesmx
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-maesmx.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-maesmx.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=demo-maesmx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-0000000000
