{
  "hosting": {
    "predeploy": ["node scripts/check-deploy-branch.js"],
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/assets/*-????????.@(js|css|png|jpg|jpeg|webp|avif|svg|woff2|woff|ttf|eot)", "headers": [ { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" } ] },
      { "source": "/assets/@(back|badges|emojis)/**", "headers": [ { "key": "Cache-Control", "value": "public,max-age=86400" } ] },
      { "source": "/@(layout|themes|demo)/**", "headers": [ { "key": "Cache-Control", "value": "public,max-age=86400" } ] }
    ]
  },
  "functions": {
    "predeploy": ["node scripts/check-deploy-branch.js"],
    "source": "functions"
  },
  "firestore": {
    "predeploy": ["node scripts/check-deploy-branch.js"],
    "indexes": "firestore.indexes.json",
    "rules": "firestore.rules"
  },
  "storage": {
    "predeploy": ["node scripts/check-deploy-branch.js"],
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}