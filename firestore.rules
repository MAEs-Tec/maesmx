rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return !signedIn()
        ? 'user'
        : request.auth.token.get('role', null) is string
          ? request.auth.token.role
          : roleFromUserDoc();
    }

    function roleFromUserDoc() {
      let userPath = /databases/$(database)/documents/users/$(currentUserKey());
      return exists(userPath) ? get(userPath).data.get('role', 'user') : 'user';
    }

    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isTechAdmin() {
      return hasAnyRole(['admin', 'tec']);
    }

    function isCoordi() {
      return hasAnyRole(['admin', 'tec', 'coordi']);
    }

    function isContentManager() {
      return hasAnyRole(['admin', 'tec', 'coordi']);
    }

    function isOwnEmail(email) {
      return signedIn()
        && request.auth.token.email is string
        && email is string
        && email.lower() == request.auth.token.email.lower();
    }

    function isOwnUserDoc(userId) {
      return signedIn() && request.auth.token.email is string
        && (userId.lower() == currentUserKey().lower() || isOwnEmail(resource.data.get('email', null)));
    }

    function currentUserKey() {
      return request.auth.token.email.split('@')[0];
    }

    function isCreatingOwnUserDoc() {
      return isOwnEmail(request.resource.data.email)
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'estudiante'
        && request.resource.data.get('points', 0) == 0
        && request.resource.data.get('totalTime', 0) == 0
        && request.resource.data.get('ratingBonusPoints', 0) == 0
        && request.resource.data.get('useCoins', 0) == 0
        && request.resource.data.get('badges', []).size() == 0
        && request.resource.data.get('background', []).size() == 0;
    }

    function doesNotChangeProtectedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'status',
        'points',
        'totalTime',
        'badges',
        'useCoins', 'email', 'uid', 'id', 'ratingBonusPoints', 'background'
      ]);
    }

    match /users/{userId} {
      allow create: if (userId == currentUserKey() && request.resource.data.get('uid', userId) == userId && request.resource.data.get('id', userId) == userId && isCreatingOwnUserDoc()) || isTechAdmin();
      allow read: if signedIn();
      allow update: if isTechAdmin() || (isOwnUserDoc(userId) && doesNotChangeProtectedUserFields());
      allow delete: if isAdmin();
    }

    match /schools/{schoolId}/subjects/{subjectId} {
      allow read: if true;
      allow write: if isTechAdmin();
    }

    match /schools/{document=**} {
      allow read: if true;
      allow write: if isTechAdmin();
    }

    match /announcements/{announcementId} {
      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      // Un estudiante solo puede pre-registrarse/darse de baja a sí mismo.
      function isOwnPreregisterUpdate() {
        return signedIn()
          && request.auth.token.email is string
          && changedOnly(['preregister', 'asistence'])
          && request.resource.data.preregister.diff(resource.data.preregister).affectedKeys().hasOnly([currentUserKey()])
          && request.resource.data.asistence.diff(resource.data.asistence).affectedKeys().hasOnly([currentUserKey()])
          && request.resource.data.preregister[currentUserKey()].uid == currentUserKey()
          && request.resource.data.asistence[currentUserKey()] == false;
      }

      allow read: if true;
      allow create, delete: if isContentManager() || hasAnyRole(['publi']);
      allow update: if isContentManager()
        || hasAnyRole(['publi'])
        || isOwnPreregisterUpdate();
    }

    // Solo quien puede entrar a /coordi registra asistencias; los MAEs solo las leen
    match /attendance/{dateId} {
      allow read: if signedIn();
      allow write: if false;

      match /report/{reportId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /asesorias/{asesoriaId} {
      allow create: if false;
      allow read: if signedIn();
      allow update, delete: if false;
    }

    // collectionGroup queries must include recordType == 'attendance'.
    match /{path=**}/report/{reportId} {
      allow read: if signedIn() && resource.data.recordType == 'attendance';
      allow write: if false;
    }
    match /settings/analytics {
      allow read: if signedIn();
      allow write: if false;
    }
    match /settings/evaluations {
      allow read: if signedIn();
      allow write: if isTechAdmin();
    }
    match /analytics/{version}/counts/{counterId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /analytics/{version}/summaries/{summaryId} {
      allow read: if isTechAdmin();
      allow write: if false;
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isContentManager();
    }

    // === BOT_FLAGS / DISCORD (uso interno admin) ===
    match /bot_flags/{flagId} {
      allow read, write: if isAdmin();
    }

    match /discord/{docId} {
      allow read, write: if isAdmin();
    }

    // === GROUP_SESSIONS ===
    match /group_sessions/{sessionId} {
      allow create: if signedIn();
      allow read: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow update: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // === REQUESTS ===
    match /requests/{requestId} {
      allow create: if signedIn();
      allow read: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow update: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // === SCHEDULE ===
    match /schedule/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
