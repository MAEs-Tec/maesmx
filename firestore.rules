rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // El rol viene del custom claim. Si una cuenta aun no tiene claim (migracion
    // incompleta o usuario nuevo sin sincronizar) se usa el rol de su doc en
    // Firestore, que solo admin/tec pueden cambiar.
    function role() {
      return !signedIn()
        ? 'user'
        : request.auth.token.get('role', null) is string
          ? request.auth.token.role
          : roleFromUserDoc();
    }

    function roleFromUserDoc() {
      let userPath = /databases/$(database)/documents/users/$(currentUserKey());
      return exists(userPath) ? get(userPath).data.get('role', 'user') : 'user';
    }

    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isTechAdmin() {
      return hasAnyRole(['admin', 'tec']);
    }

    function isCoordi() {
      return hasAnyRole(['admin', 'tec', 'coordi']);
    }

    function isContentManager() {
      return hasAnyRole(['admin', 'tec', 'coordi']);
    }

    function isOwnEmail(email) {
      return signedIn()
        && request.auth.token.email is string
        && email is string
        && email.lower() == request.auth.token.email.lower();
    }

    // El id del doc es la matricula; algunos docs viejos no traen `email`
    function isOwnUserDoc(userId) {
      return signedIn()
        && request.auth.token.email is string
        && (userId.lower() == currentUserKey().lower()
            || isOwnEmail(resource.data.get('email', null)));
    }

    function currentUserKey() {
      return request.auth.token.email.split('@')[0];
    }

    function verifiedInstitutional() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[a-z0-9._%+-]+@tec[.]mx$');
    }

    function advisoryUserKey() {
      return currentUserKey().lower();
    }

    function managesAdvisory(data) {
      return data.studentKey == advisoryUserKey()
        || data.creatorKey == advisoryUserKey()
        || isTechAdmin()
        || (hasAnyRole(['coordi'])
          && get(/databases/$(database)/documents/users/$(advisoryUserKey())).data.campus == data.campus);
    }

    match /advisoryRequests/{requestId} {
      allow read: if verifiedInstitutional() && (managesAdvisory(resource.data)
        || exists(/databases/$(database)/documents/advisoryRequests/$(requestId)/recipients/$(advisoryUserKey())));
      allow write: if false;
      match /offers/{maeKey} {
        allow read: if verifiedInstitutional()
          && (managesAdvisory(get(/databases/$(database)/documents/advisoryRequests/$(requestId)).data)
            || maeKey == advisoryUserKey());
        allow write: if false;
      }
      match /events/{eventId} {
        allow read, write: if false;
      }
      match /recipients/{userKey} {
        allow read: if verifiedInstitutional() && userKey == advisoryUserKey();
        allow write: if false;
      }
    }

    match /advisoryNotifications/{userKey}/items/{notificationId} {
      allow read: if verifiedInstitutional() && userKey == advisoryUserKey();
      allow update: if verifiedInstitutional() && userKey == advisoryUserKey()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    function isCreatingOwnUserDoc() {
      return isOwnEmail(request.resource.data.email)
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'estudiante';
    }

    function changedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Rol y estatus solo los cambia admin/tec (evita escalacion de privilegios)
    function preservesAccessFields() {
      return !changedUserFields().hasAny(['role', 'status']);
    }

    // El campus define sobre que sede manda una coordi: solo admin/tec lo cambian
    function preservesCampus() {
      return !changedUserFields().hasAny(['campus']);
    }

    // El turno solo se abre con la hora del servidor (evita falsear startTime) o se cierra
    function validActiveSessionChange() {
      return !changedUserFields().hasAny(['activeSession'])
        || !('activeSession' in request.resource.data)
        || (request.resource.data.activeSession is map
          && request.resource.data.activeSession.get('startTime', null) == request.time);
    }

    // Las horas solo suben al cerrar el turno y a lo mas lo que duro (el cliente redondea hacia abajo
    // y descarta turnos de mas de 310 min)
    function validTotalTimeChange() {
      let before = resource.data.get('totalTime', 0);
      let after = request.resource.data.get('totalTime', 0);
      let session = resource.data.get('activeSession', null);
      return !changedUserFields().hasAny(['totalTime'])
        || (session is map
          && session.get('startTime', null) is timestamp
          && !('activeSession' in request.resource.data)
          && after is number
          && after >= before
          && after - before <= 310
          && (after - before) * 60 <= (request.time - session.startTime).seconds() + 60);
    }

    // Turno y materias son del dueno; una coordi no los toca en perfiles ajenos
    function preservesOwnerOnlyFields() {
      return !changedUserFields().hasAny(['activeSession', 'subjects']);
    }

    // Una coordi solo gestiona perfiles de su campus
    function coordiOfCampus(campus) {
      return hasAnyRole(['coordi'])
        && get(/databases/$(database)/documents/users/$(currentUserKey())).data.get('campus', null) == campus;
    }

    // Flujos de la pagina que escriben en el perfil de OTRO usuario desde el navegador:
    // un estudiante evalua o registra una asesoria (puntos y bono del MAE) y quien abre
    // un perfil o el leaderboard desbloquea logros. Hasta que esto pase a Cloud
    // Functions, a los demas usuarios solo se les permite tocar esos campos.
    function changesOnlyGamificationFields() {
      return changedUserFields().hasOnly(['points', 'ratingBonusPoints', 'badges']);
    }

    match /users/{userId} {
      allow create: if isCreatingOwnUserDoc() || isTechAdmin();
      allow read: if signedIn();
      // Dueno: turno (activeSession/totalTime), tienda (useCoins), horario, materias, foto.
      // Coordi: agregar horas y puntos de asistencia de otros MAEs.
      allow update: if isTechAdmin()
        || (isOwnUserDoc(userId) && preservesAccessFields() && preservesCampus() && validActiveSessionChange() && validTotalTimeChange())
        || (coordiOfCampus(resource.data.get('campus', null)) && preservesAccessFields() && preservesCampus() && preservesOwnerOnlyFields())
        || (signedIn() && changesOnlyGamificationFields());
      allow delete: if isAdmin();
    }

    match /schools/{schoolId}/subjects/{subjectId} {
      allow read: if true;
      allow write: if isTechAdmin();
    }

    match /schools/{document=**} {
      allow read: if true;
      allow write: if isTechAdmin();
    }

    match /announcements/{announcementId} {
      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      // Un estudiante solo puede pre-registrarse/darse de baja a sí mismo.
      function isOwnPreregisterUpdate() {
        return signedIn()
          && request.auth.token.email is string
          && changedOnly(['preregister', 'asistence'])
          && request.resource.data.preregister.diff(resource.data.preregister).affectedKeys().hasOnly([currentUserKey()])
          && request.resource.data.asistence.diff(resource.data.asistence).affectedKeys().hasOnly([currentUserKey()])
          && request.resource.data.preregister[currentUserKey()].uid == currentUserKey()
          && request.resource.data.asistence[currentUserKey()] == false;
      }

      // Un estudiante pre-registrado confirma su propia asistencia (QR de la asesoría).
      // La primera confirmación reclama pointsAwarded; solo puede pasar de no-true a true.
      function isOwnAttendanceConfirm() {
        return signedIn()
          && request.auth.token.email is string
          && currentUserKey() in resource.data.get('preregister', {})
          && request.resource.data.asistence.diff(resource.data.get('asistence', {})).affectedKeys().hasOnly([currentUserKey()])
          && request.resource.data.asistence[currentUserKey()] == true
          && (changedOnly(['asistence'])
              || (changedOnly(['asistence', 'pointsAwarded', 'pointsAwardedAt', 'pointsAwardedTo'])
                  && resource.data.get('pointsAwarded', false) != true
                  && request.resource.data.pointsAwarded == true));
      }

      allow read: if true;
      allow create, delete: if isContentManager() || hasAnyRole(['publi']);
      allow update: if isContentManager()
        || hasAnyRole(['publi'])
        || (hasAnyRole(['mae']) && changedOnly([
          'asistence',
          'pointsAwarded',
          'pointsAwardedAt',
          'pointsAwardedTo'
        ]))
        || isOwnPreregisterUpdate()
        || isOwnAttendanceConfirm();
    }

    // Solo quien puede entrar a /coordi registra asistencias; los MAEs solo las leen
    match /attendance/{dateId} {
      allow read: if signedIn();
      allow write: if isCoordi();

      match /report/{reportId} {
        allow read: if signedIn();
        allow write: if isCoordi();
      }
    }

    match /asesorias/{asesoriaId} {
      // userInfo.uid es la matricula del alumno, no el uid de Firebase Auth
      function isOwnAsesoria() {
        return signedIn()
          && request.auth.token.email is string
          && resource.data.get('userInfo', {}).get('uid', '') is string
          && resource.data.userInfo.uid.lower() == currentUserKey().lower();
      }

      // El alumno evalua su asesoria y, al registrarla, se marcan los puntos otorgados
      function changesOnlyStudentFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'comment',
          'duplicate', 'pointsAwarded', 'pointsReason', 'pointsSubjectId', 'pointsAwardedAt'
        ]);
      }

      // Linked records are created atomically with their request by the server.
      allow create: if signedIn() && !asesoriaId.matches('^request_.*')
        && !request.resource.data.keys().hasAny(['requestId', 'assignmentVersion']);
      allow read: if signedIn();
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requestId', 'assignmentVersion'])
        && (resource.data.keys().hasAny(['requestId'])
          ? ((isCoordi() || isOwnAsesoria())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment']))
          : (isCoordi() || (isOwnAsesoria() && changesOnlyStudentFields())));
      allow delete: if isAdmin() && !resource.data.keys().hasAny(['requestId']);
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isContentManager();
    }

    // === BOT_FLAGS / DISCORD (uso interno admin) ===
    match /bot_flags/{flagId} {
      allow read, write: if isAdmin();
    }

    match /discord/{docId} {
      allow read, write: if isAdmin();
    }

    // === GROUP_SESSIONS ===
    match /group_sessions/{sessionId} {
      allow create: if signedIn();
      allow read: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow update: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // === REQUESTS ===
    match /requests/{requestId} {
      allow create: if signedIn();
      allow read: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow update: if isAdmin()
        || (signedIn() && (resource.data.userInfo.uid == request.auth.uid
                        || resource.data.peerInfo.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // === SCHEDULE ===
    match /schedule/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
