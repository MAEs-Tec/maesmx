{
    "name": "sakai-vue",
    "version": "3.8.0",
    "scripts": {
        "dev": "vite",
        "dev:local": "node scripts/dev-local.js",
        "emulators": "npx --yes firebase-tools@14.25.0 emulators:start --project demo-maesmx --only auth,firestore,functions,storage",
        "seed": "node scripts/seed-emulator.js",
        "build": "vite build",
        "deploy": "vite build && firebase deploy",
        "preview": "vite preview",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .gitignore",
        "lint:fix": "npm run lint -- --fix",
        "test": "node --test tests/*.test.mjs functions/tests/*.test.cjs",
        "test:emulator": "npx --yes firebase-tools@14.25.0 emulators:exec --project demo-maesmx --only auth,firestore \"node scripts/seed-emulator.js && node --test tests/advisory-requests.integration.test.mjs\""
    },
    "dependencies": {
        "chart.js": "3.3.2",
        "exceljs": "^4.4.0",
        "file-saver": "^2.0.5",
        "firebase": "^10.14.1",
        "primeflex": "^3.3.1",
        "primeicons": "^7.0.0",
        "primevue": "^3.30.2",
        "uuid": "^10.0.0",
        "vue": "^3.2.41",
        "vue-router": "^4.1.5",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@rushstack/eslint-patch": "^1.1.4",
        "@vitejs/plugin-vue": "^4.1.0",
        "@vue/eslint-config-prettier": "^7.0.0",
        "eslint": "^8.22.0",
        "eslint-plugin-vue": "^9.3.0",
        "prettier": "^2.7.1",
        "sass": "^1.55.0",
        "vite": "^4.2.1"
    }
}
