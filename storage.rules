rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.get('role', null) is string
        ? request.auth.token.role
        : 'user';
    }

    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }

    match /announcements/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if hasAnyRole(['admin', 'tec', 'coordi', 'publi'])
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if hasAnyRole(['admin', 'tec', 'coordi', 'publi']);
    }

    match /users/{email}/photo {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.email is string
        && email.lower() == request.auth.token.email.lower()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.token.email is string
        && email.lower() == request.auth.token.email.lower();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
