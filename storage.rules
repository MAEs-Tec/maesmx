rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.get('role', null) is string
        ? request.auth.token.role
        : 'user';
    }

    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }

    match /announcements/{allPaths=**} {
      allow read: if signedIn();
      // publi tambien crea anuncios y reemplaza portadas (igual que en firestore.rules)
      allow write: if hasAnyRole(['admin', 'tec', 'coordi', 'publi']);
    }

    match /users/{email}/photo {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.token.email is string
        && email.lower() == request.auth.token.email.lower();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}